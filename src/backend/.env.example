# NODE.JS HELLO WORLD SERVER - ENVIRONMENT CONFIGURATION
# ======================================================
# This is an example configuration file for the Node.js Hello World server.
# To use this file:
# 1. Copy this file to .env (e.g., cp .env.example .env)
# 2. Modify the values as needed for your environment
# 3. The actual .env file should NOT be committed to version control

# Server Configuration
# -------------------
# PORT: The TCP port on which the HTTP server will listen
# Valid values: 1024-65535 (ports below 1024 may require elevated privileges)
# Default if not specified: 3000
PORT=3000

# Environment Configuration
# ------------------------
# NODE_ENV: Defines the environment in which the application is running
# Common values: development, production, test
# Affects logging verbosity and error detail levels
NODE_ENV=development

# Logging Configuration
# --------------------
# LOG_LEVEL: Controls the verbosity of application logging
# Valid values: error, warn, info, debug
# Default if not specified: info
LOG_LEVEL=info