# NESTJS HELLO WORLD APPLICATION - ENVIRONMENT CONFIGURATION
# ===========================================================
# This is an example configuration file for the NestJS Hello World application.
# The application is built using the NestJS framework with TypeScript.
# To use this file:
# 1. Copy this file to .env (e.g., cp .env.example .env)
# 2. Modify the values as needed for your environment
# 3. The actual .env file should NOT be committed to version control

# ============================================================================
# APPLICATION METADATA
# ============================================================================
# These variables define the application identity and versioning information.
# Used by NestJS for application configuration and metadata endpoints.

# APP_NAME: The name identifier for this NestJS application
# Used in logging, health checks, and application metadata
APP_NAME=hello-world-nestjs

# APP_DESCRIPTION: Human-readable description of the application
# Used in documentation and metadata responses
APP_DESCRIPTION="Hello World API built with NestJS"

# API_VERSION: The current version of the API
# Follows semantic versioning (major.minor.patch)
# Can be used for versioning endpoints or documentation
API_VERSION=1.0.0

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Configuration for the NestJS HTTP server using the Express platform adapter.
# NestJS uses Express under the hood via @nestjs/platform-express.

# PORT: The TCP port on which the NestJS HTTP server will listen
# Valid values: 1024-65535 (ports below 1024 may require elevated privileges)
# Default if not specified: 3000
# NestJS will use this value when calling app.listen() in main.ts
PORT=3000

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# Defines the runtime environment and affects NestJS behavior and optimizations.

# NODE_ENV: Defines the environment in which the application is running
# Common values: development, production, test
# - development: Enables detailed error messages, hot reload, and debug logging
# - production: Enables NestJS production optimizations, minimal logging, and security features
# - test: Used during automated testing with Jest
# NestJS uses this to configure internal behaviors and enable/disable features
NODE_ENV=development

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Controls the NestJS Logger class behavior and output verbosity.
# NestJS provides a built-in Logger with configurable levels.

# LOG_LEVEL: Controls the verbosity of NestJS Logger output
# Valid values: error, warn, log, debug, verbose
# Hierarchy (most to least restrictive): error < warn < log < debug < verbose
# - error: Only critical errors that prevent operation
# - warn: Warning messages for potential issues
# - log: Standard informational messages (NestJS default level name)
# - debug: Detailed debugging information
# - verbose: Most detailed logging including framework internals
# Default if not specified: log (equivalent to 'info' in other loggers)
LOG_LEVEL=info

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Cross-Origin Resource Sharing (CORS) settings for the NestJS application.
# These control which domains can make requests to the API.

# CORS_ENABLED: Enable or disable CORS support
# Values: true, false
# When enabled, NestJS will add CORS headers to responses
# Default: false (CORS disabled for security)
CORS_ENABLED=false

# CORS_ORIGIN: Allowed origins for CORS requests
# Values: '*' (all origins), specific domain (e.g., 'https://example.com'),
#         or comma-separated list of domains
# Only used when CORS_ENABLED=true
# Use '*' for development, specific domains for production
CORS_ORIGIN=*

# ============================================================================
# NESTJS CONFIGURATION
# ============================================================================
# NestJS-specific configuration options for framework features.

# SWAGGER_ENABLED: Enable Swagger/OpenAPI documentation endpoint
# Values: true, false
# When enabled, NestJS will serve API documentation at /api/docs
# Recommended: false in production, true in development
SWAGGER_ENABLED=false

# GLOBAL_PREFIX: Global URL prefix for all API routes
# Examples: 'api', 'api/v1', 'v1'
# Leave empty for no prefix (routes start from root '/')
# When set to 'api', /hello becomes /api/hello
GLOBAL_PREFIX=

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# Security-related configuration for the NestJS application.
# Note: Security headers (X-Frame-Options, X-Content-Type-Options, etc.)
# are configured within the application using NestJS middleware or Helmet.
# This section is reserved for future security-related environment variables.

# Example future variables (not currently implemented):
# HELMET_ENABLED=true
# RATE_LIMIT_TTL=60
# RATE_LIMIT_MAX=100

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# For more information about NestJS configuration, visit:
# https://docs.nestjs.com/techniques/configuration
